# Configuración de Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=fedar_distribuidora

# URL de fotos de productos y portada
NEXT_PUBLIC_PHOTOS_URL=https://fedardistribuidora.com.ar/uploads/
NEXT_PUBLIC_PORTADA_URL=https://fedardistribuidora.com.ar/portada/

# Configuración de Correo SMTP (Banahosting / cPanel)
SMTP_HOST=mail.fedardistribuidora.com.ar
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@fedardistribuidora.com.ar
SMTP_PASSWORD=tu_password_de_correo
SMTP_FROM="FEDAR Distribuidora" <info@fedardistribuidora.com.ar>
